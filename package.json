{
  "name": "sneakers",
  "private": true,
  "version": "0.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:store": "npm run dev --workspace apps/store",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test \"packages/shared/test/*.test.js\""
  }
}
